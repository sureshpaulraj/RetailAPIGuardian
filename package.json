{
  "name": "retail-api-guardian",
  "version": "1.0.0",
  "description": "Omnichannel Retail API Integration Agent — powered by GitHub Copilot SDK",
  "main": "dist/agent/index.js",
  "scripts": {
    "start": "npx tsx src/agent/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npx playwright test",
    "test:api": "npx playwright test --project=api",
    "test:dashboard": "npx playwright test --project=dashboard",
    "demo": "npx tsx demos/demo-runner.ts",
    "dashboard": "npx tsx src/server.ts",
    "dashboard:ui": "npm --prefix frontend run dev",
    "dashboard:build": "npm --prefix frontend run build"
  },
  "keywords": [
    "github-copilot-sdk",
    "retail",
    "api-integration",
    "agentic"
  ],
  "author": "RetailAPIGuardian Team",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@github/copilot-sdk": "^0.1.25",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "express": "^5.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@azure/core-auth": "^1.10.1",
    "@azure/cosmos": "^4.9.1",
    "@azure/eventgrid": "^5.12.0",
    "@azure/identity": "^4.13.0",
    "@azure/keyvault-secrets": "^4.10.0",
    "@azure/monitor-query": "^1.3.3",
    "@playwright/test": "^1.58.2",
    "pptxgenjs": "^4.0.1"
  }
}
