# ──────────────────────────────────────────────────────────────
# RetailAPIGuardian — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────────────────────

# ── Azure Cosmos DB ──────────────────────────────────────────
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE=retail-api-guardian

# ── Azure Event Grid ────────────────────────────────────────
AZURE_EVENTGRID_ENDPOINT=
AZURE_EVENTGRID_KEY=

# ── Azure Key Vault ─────────────────────────────────────────
AZURE_KEYVAULT_URL=

# ── Azure Monitor / Log Analytics ───────────────────────────
AZURE_MONITOR_WORKSPACE_ID=

# ── Azure API Management ────────────────────────────────────
AZURE_APIM_SUBSCRIPTION_ID=
AZURE_APIM_RESOURCE_GROUP=
AZURE_APIM_SERVICE_NAME=

# ── Work IQ (Microsoft 365 / Teams) ────────────────────────
WORKIQ_TENANT_ID=
WORKIQ_CLIENT_ID=
WORKIQ_CLIENT_SECRET=
WORKIQ_TEAM_ID=
WORKIQ_CHANNEL_ID=
WORKIQ_WEBHOOK_URL=
WORKIQ_EMAIL_RECIPIENTS=
WORKIQ_ENABLED=true

# ── Fabric IQ (Microsoft Fabric) ───────────────────────────
FABRIC_WORKSPACE_ID=
FABRIC_WORKSPACE_NAME=
FABRIC_LAKEHOUSE_ID=
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=

# ── Server ──────────────────────────────────────────────────
PORT=3000
